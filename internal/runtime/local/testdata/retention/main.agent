// retention — authored entirely in .agent (ADR 007): the helper tool, default policy, reviewer agent,
// demo workflow, and staging environment overlay. Traces retention is operator-local config (see
// .agentic/local.yaml). The built-in mock provider and default local runtime are implicit.

tool helper {
    type native
    safety {
        sideEffects false
    }
}

policy default {
}

agent reviewer {
    model mock/gpt-4
    instructions "Summarize the tool payload as JSON."
    output AgentOut
}

workflow demo(input: DemoInput) {
    fetch = helper.echo(topic: input.topic, extra: "x")
    summarize = reviewer(echo: fetch.echo)
    return { topic: input.topic, summary: summarize.summary }
}

environment staging {
    overrides {
        agents {
            reviewer {
                constraints {
                    timeoutSeconds 99
                }
            }
        }
    }
}
