// A Terfyn program is written entirely in .agent source (ADR 003, issue #430):
// agents, workflows, tools, and policies all live here. No project.yaml is
// required — the project name is the directory name, built-in model providers
// (anthropic/*, openai/*, gemini/*, grok/*, mock/*) need no configuration, and
// their credentials come from the environment at run time.
//
// `terfyn export --format yaml` materializes the compiled resource graph as
// YAML on demand; nothing is written to disk by default.

agent assistant {
    model mock/default

    instructions """
    You are a helpful assistant.
    """
}

// The default project policy. shell_safe is the conservative starting point:
// safe reads run freely while shell commands and side-effecting tools require
// approval. Add tools and grants, then tighten this policy as the project grows.
policy default {
    preset shell_safe
}

workflow hello(input: string) -> string
    policy default
{
    return assistant(input)
}
