apiVersion: agentic.dev/v0
kind: Project
metadata:
  name: {{.ProjectName}}
spec:
  # .agent sources under the project root are discovered automatically; only
  # YAML resources (tools, policies, config) are imported here.
  imports:
    - ./policies/default.yaml
    - ./tools/helper.yaml
  defaults:
    policy: default
    model: mock/gpt-4
  providers:
    models:
      mock:
        type: mock
