// Authored entirely in .agent (ADR 003, issue #430): the reviewer agent, the
// pr-review-github workflow, and the tool and policy they use — no project.yaml, no
// YAML resources. JSON Schemas stay JSON (referenced by type). The agent selects
// `openai/gpt-4o-mini` (built-in provider, needs OPENAI_API_KEY to run); the default
// `local` runtime is implicit. The review's Markdown rendering is interpolated into
// the comment body via a ${...} argument template.

tool github {
    type native
    safety {
        trusted true
    }
}

policy guarded-writes {
    execution {
        maxTotalCostUsd 5
        maxWallClockSeconds 300
    }
    approvals {
        requiredFor {
            tool.github.pull_request.post_comment
        }
    }
}

agent reviewer {
    model openai/gpt-4o-mini
    policy guarded-writes
    constraints {
        timeoutSeconds 300
    }
    instructions """
    You are an expert code reviewer. The user message is JSON. It includes:
    - "pull_request": either a GitHub pull object (from the REST API) or a JSON-encoded string of that object.
    - "diff": optional unified diff text (may be truncated for very large PRs).

    Review for security, correctness, maintainability, and risky patterns. Be concise and actionable.

    Respond with one JSON object only (no markdown, no code fences). Use exactly this shape:
    {
      "summary": "<one line overview>",
      "findings": [
        {
          "severity": "high" | "medium" | "low" | "info",
          "file": "<path or label>",
          "title": "<short issue title>",
          "evidence": "<what in the PR suggests this>"
        }
      ],
      "findings_markdown": "<GitHub-flavored Markdown for the PR comment body: start with the line ### Findings, then one '-' bullet per finding. Each bullet: **severity** · `path` — **title**, then a short evidence sentence on the next line (indented is fine). Use '-' bullets only; do not use markdown pipe tables (never begin a line with '|'). Do not backslash-escape underscores in identifiers; use plain text or backticks (e.g. OPENAI_API_KEY or `OPENAI_API_KEY`). If findings is empty, use '### Findings' followed by a line '- No issues found.'>"
    }
    The "findings" array is the structured source of truth; "findings_markdown" must describe the same items in readable form for GitHub comments.
    If there are no issues, return an empty "findings" array, a positive summary, and findings_markdown exactly: "### Findings\n- No issues found."
    """
    output ReviewOutput
}

workflow pr-review-github(input: GitHubPRInput)
    description """
    Live GitHub path: fetch PR JSON and unified diff via the GitHub REST API, run a structured review
    with the default project model (OpenAI gpt-4o-mini), then post or update one issue comment on the PR
    (comment_strategy replace by default: PATCH existing <!-- agentic-review --> comment or POST once).
    The comment step is policy-gated unless you pass --approve for tool.github.pull_request.post_comment
    (the bundled Actions PR job passes --approve so a real comment is posted).
    Requires GITHUB_TOKEN, OPENAI_API_KEY (for the reviewer agent), and network access to GitHub/OpenAI.
    """
    policy guarded-writes
{
    fetch_pr = github.pull_request.get(owner: input.owner, repo: input.repo, number: input.number)
    fetch_diff = github.pull_request.diff(owner: input.owner, repo: input.repo, number: input.number)
    review_diff = reviewer(pull_request: fetch_pr.pull_request, diff: fetch_diff.diff)
    post_comment = github.pull_request.post_comment(owner: input.owner, repo: input.repo, number: input.number, comment_strategy: "replace", body: """
    ## Automated review

    ### Summary

    ${review_diff.summary}

    ${review_diff.findings_markdown}
    """)
    return review_diff
}
