// agent-quickstart, authored entirely in .agent (ADR 003, issue #430): agents,
// workflows, tools, and policies are all .agent declarations — no project.yaml,
// no YAML resources. The built-in `mock` provider needs no declaration, and the
// default `local` runtime is implicit.
//
// Run:  terfyn validate
//       terfyn export --format yaml     # materialize the compiled graph
//       terfyn plan
//
// Note: this workflow is straight-line. Conditionals and loops now execute
// end-to-end too (issue #259) — see examples/agent-control-flow. See
// docs/LANGUAGE.md.

policy default {
    preset shell_safe
    execution {
        maxTotalCostUsd 5
        maxWallClockSeconds 300
    }
}

tool notes {
    type native
    safety {
        sideEffects false
    }
}

agent Summarizer {
    model mock/gpt-4
    policy default
}

workflow triage(input: Alert) -> Summary policy default {
    enriched = notes.lookup(id: input.id)
    summary = Summarizer(enriched)
    return summary
}
