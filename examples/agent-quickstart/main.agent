// The .agent authoring surface (ADR 003). Agents and workflows are authored
// here; tools, policies, and project.yaml stay YAML (the interchange format).
//
// Run:  terfyn validate
//       terfyn export --format yaml     # materialize the compiled graph
//       terfyn plan
//
// Note: this workflow is straight-line. Conditionals and loops now execute
// end-to-end too (issue #259) — see examples/agent-control-flow. See
// docs/LANGUAGE.md.

agent Summarizer {
    model mock/gpt-4
}

workflow triage(input: Alert) -> Summary {
    enriched = notes.lookup(id: input.id)
    summary = Summarizer(enriched)
    return summary
}
