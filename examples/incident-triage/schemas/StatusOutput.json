{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["summary", "severity", "action"],
  "properties": {
    "summary": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["high", "medium", "low", "info"]
    },
    "action": { "type": "string" }
  },
  "additionalProperties": false
}
