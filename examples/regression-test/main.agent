// Authored entirely in .agent (ADR 003, issue #430): the writer agent, the
// gated-write workflow, and the tool and policy they use — no project.yaml, no YAML
// resources. The `tests/gated-write.yaml` capability assertion (run by `terfyn
// test`) and JSON Schemas stay in their own files; the built-in `mock` provider
// and default `local` runtime are implicit.

tool publish {
    type mock
    safety {
        trusted true
        sideEffects true
    }
}

policy gated-publish {
    execution {
        maxTotalCostUsd 5
        maxWallClockSeconds 300
    }
    approvals {
        requiredFor {
            tool.publish.default
        }
    }
}

agent writer {
    model mock/gpt-4
    policy gated-publish
    constraints {
        timeoutSeconds 60
        maxIterations 8
    }
    instructions """
    You have a publish tool. Call it once if it is available, then respond with one JSON
    object only (no markdown, no code fences):
    {"summary": "<one line>"}
    """
    grants {
        tool.publish.default
    }
    output StatusOutput
}

workflow gated-write(input: ArticleInput)
    description """
    Offline CI fixture: an agent tool loop calls a mutating mock publish. Policy
    requiredFor gates tool.publish.default. Inner agent tools do not HITL; an
    unapproved call fails closed (exit 5). terfyn test does not pass --approve.
    """
    policy gated-publish
{
    status = writer(article: input.article)
    return status
}
