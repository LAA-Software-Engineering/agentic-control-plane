// Authored in .agent: the burner agent and the burn workflow. The tool, policy,
// project config, and JSON Schemas stay YAML.

agent burner {
    model mock/gpt-4
    policy tight-budget
    constraints {
        timeoutSeconds 60
        maxIterations 8
    }
    instructions """
    You have a helper tool. Call it once if it is available, then respond with one JSON
    object only (no markdown, no code fences):
    {"summary": "<one line>"}
    """
    grants {
        tool.helper.default
    }
    output StatusOutput
}

workflow burn(input: LoopInput)
    description """
    Offline demo: an agent tool loop burns mock model cost. Turn 1 stays under
    execution.maxTotalCostUsd; turn 2 crosses it. The run aborts mid-loop with
    exit 5 and a limit_hit (kind: max_cost) event — not a HITL interrupt.
    """
    policy tight-budget
{
    status = burner(topic: input.topic)
    return status
}
