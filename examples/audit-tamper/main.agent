// Authored entirely in .agent (ADR 003, issue #430): the scribe agent, the note
// workflow, and the cheap-ceiling policy — no project.yaml, no YAML resources.
// JSON Schemas stay JSON (referenced by type); the built-in `mock` provider and
// the default `local` runtime are implicit.
//
//   terfyn validate && terfyn plan && terfyn apply --auto-approve
//   terfyn run workflow/note --input-file fixtures/sample-input.json
//   ./scripts/tamper-trace.sh   # then: terfyn audit verify  ->  fails, exit 1

policy cheap-ceiling {
    execution {
        maxTotalCostUsd 5
        maxWallClockSeconds 300
    }
}

agent scribe {
    model mock/gpt-4
    policy cheap-ceiling
    constraints {
        timeoutSeconds 60
    }
    instructions """
    You write a one-line summary of the user JSON. Respond with one JSON object only
    (no markdown, no code fences). Use exactly this shape: {"summary": "<one line>"}
    """
    output NoteOutput
}

workflow note(input: NoteInput) -> NoteOutput
    description """
    Offline demo: a single mock agent turn records a hash-linked trace. After the run
    succeeds, planting an edit in trace_events.data_json (without updating hash) makes
    terfyn audit verify fail with exit 1.
    """
    policy cheap-ceiling
{
    summary = scribe(topic: input.topic)
    return summary
}
