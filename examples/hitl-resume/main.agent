// Authored entirely in .agent (ADR 003, issue #430): the drafter agent, the publish
// workflow, and the tool and HITL policy they use — no project.yaml, no YAML
// resources. JSON Schemas stay JSON (referenced by type); the built-in `mock`
// provider and default `local` runtime are implicit.

tool publish {
    type mock
    safety {
        trusted true
        sideEffects true
    }
}

policy gated-publish {
    execution {
        maxTotalCostUsd 5
        maxWallClockSeconds 300
    }
    approvals {
        requiredFor {
            tool.publish.default
        }
    }
    hitl {
        descriptionPrefix "Publishing requires operator approval"
        interruptOn {
            publish {
                allowedDecisions { approve reject }
                description "Review publish call (${uses})"
            }
        }
    }
}

agent drafter {
    model mock/gpt-4
    policy gated-publish
    constraints {
        timeoutSeconds 60
    }
    instructions """
    You draft a short publish summary from the user JSON. Respond with one JSON object
    only (no markdown, no code fences). Use exactly this shape: {"summary": "<one line>"}
    """
    output DraftOutput
}

workflow publish(input: NoteInput)
    description """
    Offline demo: a mock agent drafts a summary, then a workflow uses: step publishes
    it. Policy requires approval for tool.publish.default and HITL interruptOn pauses
    the run (exit 0, status interrupted) with a checkpoint. Resume with
    --decision approve. This is not agent-loop fail-closed exit 5.
    """
    policy gated-publish
{
    draft = drafter(topic: input.topic)
    published = publish.default(summary: draft.summary)
    return published
}
