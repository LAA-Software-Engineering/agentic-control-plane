// Authored entirely in .agent (ADR 003, issue #430): the triager and fixer agents,
// the handoff workflow, and the tools and policies they use. Each agent keeps its
// own tool grant and policy — no project.yaml, no YAML resources. JSON Schemas stay
// JSON (referenced by type); the built-in `mock` provider and default `local`
// runtime are implicit.

policy triage-readonly {
    execution {
        maxTotalCostUsd 5
        maxWallClockSeconds 300
    }
    approvals {
        requiredFor {
            tool.patch.default
        }
    }
}

policy apply-fix {
    execution {
        maxTotalCostUsd 5
        maxWallClockSeconds 300
    }
}

tool lookup {
    type mock
    safety {
        trusted true
        sideEffects false
    }
}

tool patch {
    type mock
    safety {
        trusted true
        sideEffects true
    }
}

agent triager {
    model mock/gpt-4
    policy triage-readonly
    constraints {
        timeoutSeconds 60
        maxIterations 8
    }
    instructions """
    You triage a ticket. Call lookup if it is available, then respond with one JSON
    object only (no markdown, no code fences). Use exactly this shape:
    {
      "summary": "<one line>",
      "findings": [
        {
          "severity": "high" | "medium" | "low" | "info",
          "file": "<path or label>",
          "title": "<short issue title>",
          "evidence": "<what suggests this>"
        }
      ]
    }
    """
    grants {
        tool.lookup.default
    }
    output HandoffOutput
}

agent fixer {
    model mock/gpt-4
    policy apply-fix
    constraints {
        timeoutSeconds 60
        maxIterations 8
    }
    instructions """
    You apply a fix from a triage diagnosis. Call patch if it is available, then respond
    with one JSON object only (no markdown, no code fences). Use exactly this shape:
    {
      "summary": "<one line>",
      "findings": [
        {
          "severity": "high" | "medium" | "low" | "info",
          "file": "<path or label>",
          "title": "<short issue title>",
          "evidence": "<what you changed or verified>"
        }
      ]
    }
    """
    grants {
        tool.patch.default
    }
    output HandoffOutput
}

workflow handoff(input: TicketInput)
    description """
    Offline demo: a triager agent looks up context, then a fixer agent applies a mock
    patch. The first agent's structured output is interpolated into the second step.
    Each agent has its own tools and policy. The mock write is trusted and not in
    requiredFor, so the run succeeds without HITL or --approve.
    """
    policy apply-fix
{
    triage = triager(ticket: input.ticket)
    fix = fixer(ticket: input.ticket, diagnosis: triage.summary, findings: triage.findings)
    return fix
}
